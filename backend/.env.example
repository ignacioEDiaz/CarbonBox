PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/document_processing
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/document_processing_test

# S3 y SQS. Estos valores apuntan a LocalStack (docker compose). Para usar AWS real:
# vaciar AWS_ENDPOINT_URL y poner la región, el bucket, la URL de la cola y las credenciales
# de un usuario IAM con permisos solo sobre esa cola y ese bucket. El código no cambia.
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_BUCKET=carbonbox-uploads
SQS_QUEUE_URL=http://sqs.us-east-1.localhost.localstack.cloud:4566/000000000000/uploads
SQS_VISIBILITY_TIMEOUT_SECONDS=60
UPLOAD_MAX_FILE_SIZE_MB=10

# Bucket que usan los tests de integración (lo crea el script de LocalStack)
TEST_S3_BUCKET=carbonbox-uploads-test
