{
  "name": "carbonbox-backend",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/main/index.ts",
    "test": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js --watch",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "test:unit": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js --selectProjects unit",
    "test:integration": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js --selectProjects integration"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "awilix": "13.0.5",
    "convict": "6.2.5",
    "dotenv": "18.0.7",
    "fastify": "5.12.5"
  },
  "devDependencies": {
    "@types/convict": "6.1.6",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "jest": "30.5.2",
    "prisma": "7.10.0",
    "ts-jest": "29.4.14",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
